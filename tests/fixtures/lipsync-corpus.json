{
  "version": 1,
  "note": "Golden-span corpus (LIP-07 automated half). text -> chars with SYNTHETIC uniform timing (msPerChar; deterministic, NOT real audio) -> merge output. phonemeSequence is the G2P-level sequence (diphthong glide spans excluded). Updating an expectation is a conscious review: say why in the commit message.",
  "tolerances": {"spanSumToleranceMs":1,"minSpanMs":17.5,"maxWordOverflowMs":1},
  "cases": [
    {"id":"control-lips","group":"control","path":"phoneme","text":"Map, mop, pop — fine, five, very — wine, white","msPerChar":55,"expect":{"phonemeSequence":["M","AE","P","M","AA","P","P","AA","P","F","AY","N","F","AY","V","V","EH","R","IY","W","AY","N","W","AY","T"]}},
    {"id":"control-sibilants","group":"control","path":"phoneme","text":"see, she — sip, ship — so, show","msPerChar":55,"expect":{"phonemeSequence":["S","IY","SH","IY","S","IH","P","SH","IH","P","S","OW","SH","OW"]}},

    {"id":"conv-forecast","group":"conversational","path":"phoneme","text":"The forecast says it will be cloudy until noon","msPerChar":40,"expect":{"phonemeSequence":["DH","AH","F","AA","R","EH","K","AE","S","T","S","EH","Z","IH","T","W","IH","L","B","IY","K","L","AW","D","IY","AH","N","T","IH","L","N","UW","N"]}},

{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    // exactOptionalPropertyTypes is deliberately OFF for v1.1: it churns optional-prop assignment
    // patterns across the whole UI layer for marginal gain. Decision D6, revisit post-v1.1
    // (.planning/phases/14-architecture-guards/14-CONTEXT.md).
    "types": []
  },
  "include": ["src"]
}
